{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geo-vigilant",
  "account_id": "918a8da3c41883f3c214baebe7a820be",
  "main": "src/server/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    // Bound so the Worker can delegate unmatched client routes (/map, /nodes/:id)
    // back to the asset router instead of 404ing them.
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "geo-vigilant-db",
      "database_id": "a7d2d2fb-2111-42fe-9050-ebe0c5992164",
      "migrations_dir": "drizzle"
    }
  ]
}
