{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geo-vigilant",
  // account_id is not committed: wrangler reads CLOUDFLARE_ACCOUNT_ID, or prompts.
  "main": "src/server/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "geo-vigilant-db",
      // From `wrangler d1 create geo-vigilant-db`. Also keys the local dev
      // database, so re-run db:migrate:local and db:seed:local after changing it.
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ]
}
